{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clicky.local/hermes-clicky-plugin/protocol/schema.json",
  "title": "Hermes Clicky Plugin Protocol",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/pointToTargetRequest"
    },
    {
      "$ref": "#/$defs/explainScreenRequest"
    },
    {
      "$ref": "#/$defs/observeScreenRequest"
    },
    {
      "$ref": "#/$defs/getCapabilitiesRequest"
    },
    {
      "$ref": "#/$defs/capabilitiesResponse"
    },
    {
      "$ref": "#/$defs/observeScreenResponse"
    },
    {
      "$ref": "#/$defs/explainScreenResponse"
    },
    {
      "$ref": "#/$defs/pointToTargetResponse"
    },
    {
      "$ref": "#/$defs/actionProposalsResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "permission": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "errorResponse": {
      "type": "object",
      "required": [
        "protocolVersion",
        "ok",
        "status",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "status": {
          "type": "string",
          "enum": [
            "permission_denied",
            "bridge_unavailable",
            "error"
          ]
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "protocolVersion": {
          "const": "clicky.hermes.v1"
        }
      },
      "additionalProperties": true
    },
    "capability": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "capabilitiesResponse": {
      "type": "object",
      "required": [
        "protocolVersion",
        "ok",
        "status",
        "platform",
        "capabilities",
        "activePermissionTier",
        "availablePermissionTiers",
        "permissionTierChange"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "plugin": {
          "type": "object"
        },
        "capabilities": {
          "type": "object",
          "required": [
            "observeScreen",
            "explainScreen",
            "pointToTarget",
            "overlay",
            "osControl"
          ],
          "properties": {
            "observeScreen": {
              "$ref": "#/$defs/capability"
            },
            "explainScreen": {
              "$ref": "#/$defs/capability"
            },
            "pointToTarget": {
              "$ref": "#/$defs/capability"
            },
            "overlay": {
              "$ref": "#/$defs/capability"
            },
            "osControl": {
              "$ref": "#/$defs/capability"
            }
          },
          "additionalProperties": true
        },
        "protocolVersion": {
          "const": "clicky.hermes.v1"
        },
        "activePermissionTier": {
          "$ref": "#/$defs/permissionTier"
        },
        "defaultPermissionTier": {
          "$ref": "#/$defs/permissionTier"
        },
        "availablePermissionTiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permissionTier"
          },
          "minItems": 5
        },
        "permissionTierChange": {
          "type": "string",
          "const": "explicit_user_setting_or_command_required"
        },
        "fullControlPolicy": {
          "type": "string",
          "const": "external_user_configuration_only"
        }
      },
      "additionalProperties": true
    },
    "display": {
      "type": "object",
      "required": [
        "id",
        "bounds",
        "scale",
        "isCursorScreen"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "bounds": {
          "$ref": "#/$defs/rect"
        },
        "scale": {
          "type": "number"
        },
        "isCursorScreen": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "rect": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "mode",
        "width",
        "height",
        "mime"
      ],
      "properties": {
        "mode": {
          "enum": [
            "metadataOnly",
            "file",
            "base64"
          ]
        },
        "path": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "mime": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "observeScreenResponse": {
      "type": "object",
      "required": [
        "protocolVersion",
        "ok",
        "status",
        "observationId",
        "platform",
        "displays",
        "images"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "status": {
          "const": "observed"
        },
        "observationId": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "capturedAt": {
          "type": "string"
        },
        "coordinateSpace": {
          "type": "string"
        },
        "displays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/display"
          }
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/image"
          }
        },
        "protocolVersion": {
          "const": "clicky.hermes.v1"
        }
      },
      "additionalProperties": true
    },
    "region": {
      "type": "object",
      "required": [
        "label",
        "normalized"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "normalized": {
          "$ref": "#/$defs/point"
        },
        "physical": {
          "$ref": "#/$defs/physicalPoint"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": true
    },
    "explainScreenResponse": {
      "type": "object",
      "required": [
        "protocolVersion",
        "ok",
        "status",
        "explanation"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "status": {
          "const": "explained"
        },
        "explanation": {
          "type": "string"
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          }
        },
        "protocolVersion": {
          "const": "clicky.hermes.v1"
        }
      },
      "additionalProperties": true
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "physicalPoint": {
      "type": "object",
      "required": [
        "x",
        "y",
        "screen"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "screen": {
          "type": "string"
        }
      }
    },
    "pointToTargetResponse": {
      "type": "object",
      "required": [
        "protocolVersion",
        "ok",
        "status",
        "target",
        "overlayRendered"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "pointed",
            "no_target",
            "low_confidence",
            "permission_denied",
            "bridge_unavailable",
            "error"
          ]
        },
        "target": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "normalized": {
          "$ref": "#/$defs/point"
        },
        "physical": {
          "$ref": "#/$defs/physicalPoint"
        },
        "reasoning": {
          "type": "string"
        },
        "overlayRendered": {
          "type": "boolean"
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "protocolVersion": {
          "const": "clicky.hermes.v1"
        }
      },
      "additionalProperties": true
    },
    "getCapabilitiesRequest": {
      "type": "object",
      "required": [
        "protocolVersion",
        "method"
      ],
      "properties": {
        "protocolVersion": {
          "const": "clicky.hermes.v1"
        },
        "method": {
          "const": "getCapabilities"
        },
        "platform": {
          "type": "string",
          "enum": [
            "auto",
            "windows",
            "macos"
          ]
        }
      },
      "additionalProperties": false
    },
    "observeScreenRequest": {
      "type": "object",
      "required": [
        "protocolVersion",
        "method"
      ],
      "properties": {
        "protocolVersion": {
          "const": "clicky.hermes.v1"
        },
        "method": {
          "const": "observeScreen"
        },
        "imageMode": {
          "enum": [
            "metadataOnly",
            "file",
            "base64"
          ]
        },
        "includeCursorScreenOnly": {
          "type": "boolean"
        },
        "outputDirectory": {
          "type": "string"
        },
        "debugWriteScreenshots": {
          "type": "boolean"
        },
        "maxBase64Bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "explainScreenRequest": {
      "type": "object",
      "required": [
        "protocolVersion",
        "method",
        "task"
      ],
      "properties": {
        "protocolVersion": {
          "const": "clicky.hermes.v1"
        },
        "method": {
          "const": "explainScreen"
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "observationId": {
          "type": "string"
        },
        "screenId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "pointToTargetRequest": {
      "type": "object",
      "required": [
        "protocolVersion",
        "method",
        "target"
      ],
      "properties": {
        "protocolVersion": {
          "const": "clicky.hermes.v1"
        },
        "method": {
          "const": "pointToTarget"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string"
        },
        "screenId": {
          "type": "string"
        },
        "renderOverlay": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "getCapabilitiesResponse": {
      "allOf": [
        {
          "$ref": "#/$defs/capabilitiesResponse"
        }
      ]
    },
    "nativeSelector": {
      "type": "object",
      "description": "semantic selector supplied by a native runtime when available; never a provider or platform API payload",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "accessibilityLabel",
            "automationId",
            "bundleIdentifier",
            "processName",
            "windowTitle",
            "semanticRole",
            "unknown"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "screen": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "actionProposal": {
      "type": "object",
      "description": "inert proposal only; describes a possible future desktop action and never executes it",
      "required": [
        "id",
        "actionType",
        "targetLabel",
        "confidence",
        "riskLevel",
        "requiresConfirmation",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "actionType": {
          "type": "string",
          "enum": [
            "click",
            "doubleClick",
            "typeText",
            "hotkey",
            "openApplication",
            "focusWindow",
            "waitForScreenChange",
            "stop"
          ]
        },
        "targetLabel": {
          "type": "string",
          "minLength": 1
        },
        "coordinates": {
          "$ref": "#/$defs/physicalPoint"
        },
        "normalized": {
          "$ref": "#/$defs/point"
        },
        "nativeSelector": {
          "$ref": "#/$defs/nativeSelector"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "riskLevel": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "blocked"
          ]
        },
        "requiresConfirmation": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "inputPreview": {
          "type": "string"
        },
        "hotkey": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "application": {
          "type": "string"
        },
        "waitCondition": {
          "type": "string"
        },
        "blockedReason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "actionProposalsResponse": {
      "type": "object",
      "description": "inert action-proposal response; separate from visual pointToTarget results and not an execution result",
      "required": [
        "protocolVersion",
        "ok",
        "status",
        "actionMode",
        "proposals"
      ],
      "properties": {
        "protocolVersion": {
          "const": "clicky.hermes.v1"
        },
        "ok": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "blocked",
            "no_action",
            "error"
          ]
        },
        "actionMode": {
          "type": "string",
          "enum": [
            "confirmBeforeAction",
            "scopedAutopilot",
            "fullControl"
          ],
          "default": "confirmBeforeAction"
        },
        "proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionProposal"
          }
        },
        "summary": {
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "permissionTier": {
          "$ref": "#/$defs/permissionTier"
        },
        "permissionDecisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permissionDecision"
          }
        }
      },
      "additionalProperties": false
    },
    "permissionTier": {
      "type": "string",
      "enum": [
        "observe",
        "point",
        "confirmBeforeAction",
        "scopedAutopilot",
        "fullControl"
      ]
    },
    "permissionDecision": {
      "type": "object",
      "description": "inert policy decision for a proposed future action; never an execution result",
      "required": [
        "decision",
        "permissionTier",
        "actionType",
        "reason"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "requireConfirmation",
            "block"
          ]
        },
        "permissionTier": {
          "$ref": "#/$defs/permissionTier"
        },
        "actionType": {
          "type": "string",
          "enum": [
            "click",
            "doubleClick",
            "typeText",
            "hotkey",
            "openApplication",
            "focusWindow",
            "waitForScreenChange",
            "stop"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "requiresExplicitUserSetting": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
